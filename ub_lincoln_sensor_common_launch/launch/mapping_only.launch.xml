<launch>  
  <!-- LIDAR Config-->
  <arg name="vehicle_mirror_param_file" default="$(find-pkg-share ub_lincoln_vehicle_description)/config/mirror.param.yaml"/>
  <arg name="output_file_name" description="Please provide the name of the bag you are collecting along with path if no path bag will be saved in WORKINGDIR"/>
  <arg name="mapping_topics" description="Topics needed for mapping" default="/sensing/lidar/top/pointcloud_raw_ex /sensing/gnss/novatel/oem7/imu/data_raw /sensing/gnss/novatel/oem7/imu/data /sensing/gnss/novatel/oem7/fix /sensing/gnss/novatel/oem7/bestutm  /tf_static /tf"/>
  <arg name="topics_to_record" default="$(var mapping_topics)" description="Please provide the topics you want to record or give -a to record all published topics."/>

  <!-- Publish Lidar's Static Tf w.r.t. base_link -->
  <executable cmd="ros2 run tf2_ros static_transform_publisher --x 1.24 --y 0 --z 1.93 --roll 0.0 --pitch 0.0 --yaw 0.0 --frame-id base_link --child-frame-id velodyne"/>
  
  <!-- Publish Gnss & Imu's Static Tf w.r.t. base_link -->
  <executable cmd="ros2 run tf2_ros static_transform_publisher --x -0.17 --y 0 --z 0.6 --roll 0.0 --pitch 0.0 --yaw 0.0 --frame-id base_link --child-frame-id imu_link"/>

  <!-- Sensing -->
  <group>
    <push-ros-namespace namespace="sensing"/>

    <!-- LIDAR -->
    <group>
      <let name="driver_pointcloud_topic_name" value="/velodyne_points"/>
      <push-ros-namespace namespace="lidar"/>
      <group>
        <push-ros-namespace namespace="top"/>
        <include file="$(find-pkg-share velodyne)/launch/velodyne-all-nodes-VLP32C-composed-launch.py">
        </include>
      </group>
    </group>

    <!-- GNSS -->
    <group>
      <let name="navsatfix_topic_name" value="/sensing/gnss/novatel/oem7/fix"/>
      <push-ros-namespace namespace="gnss"/>
      <group>
        <set_env name="NOVATEL_OEM7_DRIVER_PARAM_OVERRIDES_PATH" value="$(find-pkg-share ub_lincoln_sensor_common_launch)/config/novatel_overrides_std_msg_topics.yaml"/>
        <include file="$(find-pkg-share novatel_oem7_driver)/launch/oem7_net.launch.py">
          <arg name="oem7_ip_addr" value="192.168.100.201"/>
          <arg name="oem7_port" value="3005"/>
        </include>
      </group>
    </group>
  </group>

  <!-- Ros Bag Record -->
  <executable cmd="ros2 bag record -o $(var output_file_name) /sensing/lidar/top/velodyne_packets /sensing/lidar/top/velodyne_points /sensing/gnss/novatel/oem7/imu/data /sensing/gnss/novatel/oem7/imu/data_raw /sensing/gnss/novatel/oem7/fix /sensing/gnss/novatel/oem7/bestutm /tf /tf_static"/>
  
</launch>
